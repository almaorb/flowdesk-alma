// FlowDesk data model.
//
// Every tenant-owned table carries an `orgId`. The API never queries these
// models without it: `tenantDb(orgId)` (see src/db/tenant.ts) is a Prisma
// client extension that injects the tenant filter into every operation and
// throws if a query would otherwise escape its tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

// Declaration order matters: Postgres orders enum values as declared, so
// `ORDER BY priority DESC` sorts URGENT first without a CASE expression.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
  REOPENED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Per-tenant ticket counter, bumped inside the create transaction so ticket
  /// numbers are dense and scoped to the org (ORG-1, ORG-2, ...).
  ticketSeq Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  tickets    Ticket[]
  comments   Comment[]
  tags       Tag[]
  invites    Invite[]
  attachment Attachment[]
  auditLogs  AuditLog[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  /// Globally unique so that login needs an email + password only, with no
  /// tenant selector. See README "Architecture decisions".
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization      Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]
  ticketsAsCustomer Ticket[]       @relation("TicketCustomer")
  ticketsAssigned   Ticket[]       @relation("TicketAssignee")
  ticketsResponded  Ticket[]       @relation("TicketFirstResponder")
  comments          Comment[]
  attachments       Attachment[]
  invitesSent       Invite[]       @relation("InviteCreatedBy")
  auditLogs         AuditLog[]

  @@index([orgId, role])
  @@index([orgId, name])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the opaque token; the raw value only ever exists in transit.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Invite {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        Role      @default(AGENT)
  /// Opaque invite token, kept in the clear so an admin can re-copy the link.
  token       String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InviteCreatedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId, email])
  @@index([orgId, createdAt])
  @@map("invites")
}

model Ticket {
  id          String       @id @default(cuid())
  orgId       String
  /// Human-facing, per-org sequential number.
  number      Int
  title       String
  description String
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)

  customerId String
  assigneeId String?

  /// First ADMIN/AGENT comment on the ticket; drives the SLA + analytics.
  firstResponseAt  DateTime?
  firstResponderId String?

  /// Materialised so filtering/sorting on "about to breach" stays in SQL.
  slaDeadline   DateTime
  slaBreached   Boolean   @default(false)
  slaBreachedAt DateTime?

  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer       User         @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  firstResponder User?        @relation("TicketFirstResponder", fields: [firstResponderId], references: [id], onDelete: SetNull)

  comments    Comment[]
  attachments Attachment[]
  tags        TicketTag[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, priority])
  @@index([orgId, assigneeId])
  @@index([orgId, customerId])
  @@index([orgId, createdAt])
  @@index([orgId, updatedAt])
  @@index([orgId, slaBreached])
  @@index([orgId, status, priority])
  @@index([firstResponderId])
  @@map("tickets")
}

model Comment {
  id         String   @id @default(cuid())
  orgId      String
  ticketId   String
  authorId   String?
  parentId   String?
  body       String
  /// Internal notes are never serialised to a CUSTOMER.
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent       Comment?     @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]    @relation("CommentThread")

  @@index([ticketId, createdAt])
  @@index([orgId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model Tag {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String   @default("#2563eb")
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tickets      TicketTag[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("tags")
}

model TicketTag {
  ticketId String
  tagId    String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
  @@map("ticket_tags")
}

model Attachment {
  id           String   @id @default(cuid())
  orgId        String
  ticketId     String
  uploadedById String?
  filename     String
  contentType  String
  sizeBytes    Int
  /// Metadata only — FlowDesk records the pointer, it does not store bytes.
  url          String?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([orgId])
  @@map("attachments")
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, action])
  @@index([orgId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
